# Neon Console -> your project -> Connect -> Pooled connection.
# Use the same URL for the app and Drizzle migrations. Never commit the real password.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_PROJECT-pooler.YOUR_REGION.aws.neon.tech/neondb?sslmode=require

# Required in production. Generate with: openssl rand -base64 48
AUTH_SECRET=

NEXT_PUBLIC_APP_NAME=TradeMind Journal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Free local AI coach (default). Install Ollama and pull the model; no API key is needed.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Use AI_PROVIDER=rules to disable language-model calls entirely.

# Optional paid external provider. Not needed for local Ollama.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Private Vercel Blob storage. Connecting a store in Vercel normally injects these.
# BLOB_READ_WRITE_TOKEN is useful when testing that store locally; OIDC is automatic on Vercel.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
